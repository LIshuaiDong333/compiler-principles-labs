[非终结符]
E S_list S A B D
[终结符]
id ( ) + - * = int return IntConst Semicolon
[文法起始符]
P
[生成式]
P -> S_list;
S_list -> S Semicolon S_list;
S_list -> S Semicolon;
S -> D id;
D -> int;
S -> id = E;
S -> return E;
E -> E + A;
E -> E - A;
E -> A;
A -> A * B;
A -> B;
B -> ( E );
B -> id;
B -> IntConst;